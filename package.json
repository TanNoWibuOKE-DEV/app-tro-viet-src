{
  "name": "troviet-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Trọ Việt Monorepo - Smart & Safe Rental Finder for Vietnamese",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:web": "npm run web --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/mobile",
    "build:web": "npm run build:web --workspace=apps/mobile",
    "build:android": "npm run build:android --workspace=apps/mobile",
    "build:ios": "npm run build:ios --workspace=apps/mobile",
    "build:apk": "cd apps/mobile && npx eas-cli build -p android --profile preview",
    "postinstall": "npm run build --workspace=@troviet/shared"
  },
  "keywords": [
    "troviet",
    "rental",
    "vietnam",
    "expo",
    "react-native",
    "supabase"
  ],
  "author": "Trọ Việt Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
