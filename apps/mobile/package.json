{
  "name": "@troviet/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "expo export -p web",
    "build:web": "expo export -p web",
    "build:android": "expo export -p android",
    "build:ios": "expo export -p ios",
    "postinstall": "cd ../.. && npm run build --workspace=@troviet/shared"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@troviet/shared": "*",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.5.4"
  }
}
